rules_version = '2';

// StudentHUB – pravidlá prístupu k databáze Firestore.
// Firebase Console → Firestore Database → Rules → vlož celý súbor → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(userDoc()) && get(userDoc()).data.approved == true; }
    function admin() { return approved() && get(userDoc()).data.role == 'admin'; }
    // Funkcia je zapnutá, kým ju admin v nastaveniach nevypne
    function enabled(key) {
      let s = /databases/$(database)/documents/settings/app;
      return !exists(s) || get(s).data.get(key, true) != false;
    }

    // ---------- Používatelia (register) ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin()
                    || (approved() && resource.data.approved == true));
      // Nová registrácia: iba vlastný dokument, vždy ako neschválený študent
      allow create: if admin() || (signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.approved == false
                    && request.resource.data.email == request.auth.token.email);
      // Študent smie meniť iba meno, telefón, mesto a profilovú fotku (malý JPEG, max. ~60 kB)
      allow update: if admin() || (request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name', 'phone', 'city', 'photo'])
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() < 61440
                            && request.resource.data.photo.matches('^data:image/jpeg;base64,.*'))));
      allow delete: if admin();
    }

    // meta/versions – časy poslednej zmeny zbierok (cache v prehliadači); študent smie označiť iba zmenu registra
    // meta/stats    – odhad obsadeného úložiska; študent ho mení pri nahratí/zmazaní práce (max. ±50 MB naraz)
    // meta/usage    – presná spotreba z Google Cloud, zapisuje ju iba Cloud Function; číta iba admin
    match /meta/{id} {
      allow read: if approved() && (id != 'usage' || admin());
      allow create: if admin();
      allow update: if admin()
                    || (id == 'versions' && approved()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users']))
                    || (id == 'stats' && approved()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storage_bytes', 'submissions_count'])
                        && request.resource.data.storage_bytes - resource.data.storage_bytes <= 52428800
                        && request.resource.data.storage_bytes - resource.data.storage_bytes >= -52428800
                        && request.resource.data.submissions_count - resource.data.submissions_count <= 1
                        && request.resource.data.submissions_count - resource.data.submissions_count >= -1);
    }

    // Log aktivít – každý prihlásený zapisuje iba záznamy o sebe, čítať a mazať ich môže iba admin
    match /logs/{id} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.at == request.time
                    && request.resource.data.action is string && request.resource.data.action.size() <= 80
                    && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow read, delete: if admin();
    }

    match /settings/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    match /subjects/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    match /assignments/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    match /schedule/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    match /announcements/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // ---------- Študijné materiály: študenti pridávajú, admin schvaľuje ----------
    match /materials/{id} {
      allow read: if approved() && (resource.data.status == 'approved'
                    || resource.data.uploader_id == request.auth.uid || admin());
      allow create: if approved() && request.resource.data.uploader_id == request.auth.uid
                    && (request.resource.data.status == 'pending' || admin());
      allow update: if admin();
      allow delete: if admin() || (approved() && resource.data.uploader_id == request.auth.uid
                    && resource.data.status != 'approved');
    }

    // ---------- Burza kníh a skrípt ----------
    match /market/{id} {
      allow read: if approved();
      allow create: if admin() || (approved() && request.resource.data.seller_id == request.auth.uid
                    && request.resource.data.status == 'active');
      allow update: if admin() || (approved() && resource.data.seller_id == request.auth.uid
                    && request.resource.data.seller_id == request.auth.uid);
      allow delete: if admin() || (approved() && resource.data.seller_id == request.auth.uid);
    }

    // ---------- Odovzdané práce ----------
    match /submissions/{id} {
      allow read: if approved() && (resource.data.student_id == request.auth.uid || admin());
      allow create: if approved() && enabled('uploads_enabled')
                    && request.resource.data.student_id == request.auth.uid
                    && request.resource.data.status == 'submitted';
      allow update: if admin();
      allow delete: if admin() || (approved() && resource.data.student_id == request.auth.uid
                    && resource.data.status == 'submitted');
    }

    // ---------- Správy ----------
    // Admin NEvidí cudzie súkromné správy – iba členovia konverzácie.
    match /conversations/{cid} {
      allow read: if approved() && (resource == null || request.auth.uid in resource.data.members);
      // Súkromnú konverzáciu (2 členovia) založí ktokoľvek, skupinu iba admin
      allow create: if approved() && enabled('messaging_enabled')
                    && request.resource.data.created_by == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 400
                    && ((request.resource.data.is_group == false && request.resource.data.members.size() == 2)
                        || (request.resource.data.is_group == true && admin()));
      allow update: if approved() && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['last_message_at', 'last_message', 'last_sender', 'reads', 'unread']);

      match /messages/{mid} {
        function conv() { return get(/databases/$(database)/documents/conversations/$(cid)).data; }
        function member() { return request.auth.uid in conv().members; }
        allow read: if approved() && member();
        // Do skupín píšu iba admini, súkromné správy obaja členovia
        allow create: if approved() && enabled('messaging_enabled') && member()
                      && (conv().is_group != true || admin())
                      && request.resource.data.sender_id == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 4000;
      }
    }
  }
}
